# Vercel Environment Variables
# คัดลอกไฟล์นี้เป็น .env.local สำหรับ development หรือตั้งใน Vercel Dashboard

# URL ของ Google Apps Script Web App (required)
# ได้จาก: GAS Editor → Deploy → Web app → URL
GAS_WEB_APP_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# หมายเหตุ:
# - Frontend ใช้ apiBaseUrl: "/api/gas" ใน config.js (ไม่ต้องตั้ง env นี้ฝั่ง client)
# - api/gas.js อ่าน GAS_WEB_APP_URL แล้ว forward request ไป GAS
# - ห้ามใส่ GAS URL ตรงใน config.js

# สำหรับ Phase 3 (LINE Integration) — ยังไม่ implement
# LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token
# LINE_CHANNEL_SECRET=your_line_channel_secret
